# SRS Proxy 镜像 - 与 origin 同版本 v7.0.157
FROM dockerproxy.com/library/golang:1.21 AS builder
RUN git clone --depth 1 --branch v7.0.157 https://github.com/ossrs/srs.git /srs
WORKDIR /srs/trunk/proxy/cmd
RUN go mod download && go build -o /out/srs-proxy

FROM dockerproxy.com/library/debian:12-slim
WORKDIR /
COPY --from=builder /out/srs-proxy /usr/local/bin/srs-proxy

RUN mkdir -p /trunk/research

EXPOSE 1935 1985 8080 8000/udp 12025

CMD ["srs-proxy"]